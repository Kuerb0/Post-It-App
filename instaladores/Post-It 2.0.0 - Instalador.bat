  let L=lines().filter(l=>!isHead(l));
  if(L.length>1)L=L.filter(l=>!blank(l));
  if(!L.length)return;
  const has=L.map(l=>l.querySelector('.rep')),all=has.every(Boolean); // todas ya periódicas → se quitan
  L.forEach((l,i)=>{
    if(all)return has[i].remove();
    if(has[i])return;
    (l.firstElementChild?.type=='checkbox'?l.firstElementChild:addBox(l)).insertAdjacentHTML('afterend',REP);
  });
