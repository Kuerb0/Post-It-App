</div>
<div id=est><span class=g>Letra <button data-r=fsr data-m=- title="Menos">−</button><input type=range id=fsr min=9 max=30 step=1><button data-r=fsr data-m=+ title="Más">+</button><span id=fsv></span></span><span class=g>Interlineado <button data-r=lhr data-m=- title="Menos">−</button><input type=range id=lhr min=1 max=2.6 step=.05><button data-r=lhr data-m=+ title="Más">+</button><span id=lhv></span></span><button id=estr>Restablecer</button></div>
