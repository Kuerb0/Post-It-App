// varias fechas de golpe: continua desde la ultima cabecera del texto (o desde hoy) con un dia por cabecera
const toggleDates=()=>dts.style.display=dts.style.display=='flex'?'none':'flex';
dts.onclick=e=>{const n=+e.target.dataset.n;if(n){addDays(n);dts.style.display='none'}};
