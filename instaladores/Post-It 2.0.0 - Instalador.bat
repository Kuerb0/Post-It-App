// ── «/»: menú de opciones junto al cursor (se filtra al escribir, ↑↓ Intro, Esc). «Alarma» abre el selector de fecha y hora (alp).
const SL=[['alarm','⏰ Alarma'],['task','☑ Tarea'],['fold','📁 Carpeta'],['head','H Título'],['ul','• Viñetas'],['ol','1. Numerada'],['dates','📅 Varias fechas'],['repeat','🔁 Periódica']];
let slN=null,slAt=0,slSel=0,slItems=[];
function caretRect(){
  const s=getSelection();if(!s.rangeCount)return ed.getBoundingClientRect();
  let r=s.getRangeAt(0).getBoundingClientRect();
  if(!r.height){const n=s.anchorNode;r=(n.nodeType==1?n:n.parentElement).getBoundingClientRect()} // línea vacía: el rectángulo del cursor mide 0
