const esc=s=>s.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
// ★ principal (siempre arranca) · ⏻ arranca con Windows (si no, la nota queda dormida) · ✕ cerrar (dormir ahora)
const btn=n=>`<span class=t><button data-a=main class="${n.main?'a':''}" title="Principal">★</button><button data-a=ini class="${n.start?'a':''}" title="${n.main?'La principal siempre arranca':'Abrir al iniciar'}">⏻</button>${n.open?'<button data-a=cerrar title="Cerrar (dormir)">✕</button>':''}</span>`;
function pintar(){
  const g=document.getElementById('g'),l=document.getElementById('l'),mas=document.getElementById('mas'),res=L.slice(8);
  g.innerHTML=L.slice(0,8).map(n=>`<div class="c ${n.open?'on':'off'}" data-id="${n.id}" style="background:${n.color}"><div class=m>${n.html}</div>${btn(n)}</div>`).join('')
    +(L.length<8?'<div class=v data-a=nueva>＋</div>':'');
  l.innerHTML=res.map(n=>`<div class="r ${n.open?'':'off'}" data-id="${n.id}" style="border-color:${n.color}"><span>${esc(titulo(n))}</span>${btn(n)}</div>`).join('');
  if(!res.length)lista=false;
  g.style.display=lista?'none':'grid';l.style.display=lista?'block':'none';
  mas.style.display=res.length?'':'none';mas.textContent=lista?'‹ Volver':`Más (${res.length}) ›`;
}
document.onclick=e=>{
  const b=e.target.closest('[data-a]'),c=e.target.closest('[data-id]'),a=b?.dataset.a;
  if(a=='mas'){lista=!lista;return pintar()}
  if(a=='nueva')return api.lanz('nueva');
  if(c)api.lanz(a||'abrir',c.dataset.id);
};
onkeydown=e=>{if(e.key=='Escape')api.lanz('esc')};
api.onLanz(l=>{L=l;pintar()});
</script>
:::END
:::BEGIN calendario.html|text|2b63d32ac2dce7eab615fcaef0b30bac97c102be3b20de96e0d9aa8a0419e612
<!doctype html><meta charset=utf-8><title>Post-It · Calendario</title>
<style>
body{margin:0;padding:20px 24px;background:#262626;color:#eee;font:14px 'Segoe UI',sans-serif}
h2{margin:0 0 4px;font-size:17px;font-weight:600}
p{margin:6px 0;color:#bbb;line-height:1.45}
#est{padding:8px 10px;margin:12px 0;border-radius:6px;background:#1c1c1c;color:#eee}
input{width:100%;box-sizing:border-box;padding:8px;margin:6px 0;border:1px solid #555;border-radius:4px;background:#1c1c1c;color:#eee;font:13px Consolas,monospace}
button{padding:7px 14px;margin:6px 8px 0 0;border:0;border-radius:4px;background:#3a86ff;color:#fff;cursor:pointer;font:inherit}
button.s{background:#444}
#res{margin-top:8px;min-height:20px}
ol{margin:6px 0;padding-left:20px;color:#bbb;line-height:1.5}
</style>
<h2>Calendario en tus notas</h2>
<p>Post-It enseña tus citas bajo cada fecha de las notas unidas (botón 📅). Si tienes <b>Outlook clásico</b> abierto, las lee de él y recuerda el color de cada etiqueta. Si no, usa tu <b>enlace ICS</b>.</p>
<div id=est>Comprobando…</div>
<p><b>Enlace ICS</b> (Outlook web → Configuración → Calendario → Calendarios compartidos → Publicar un calendario → ICS):</p>
<input id=u placeholder="https://outlook.live.com/owa/calendar/…/calendar.ics" spellcheck=false>
<button id=pr class=s>Probar enlace</button><button id=gu>Guardar</button>
<div id=res></div>
<script>
const $=id=>document.getElementById(id);
async function estado(){
  const g=await api.icsGet();$('u').value=g.ics;
  const o={outlook:'Leyendo de Outlook clásico (con los colores de tus etiquetas).',ics:'Leyendo del enlace ICS'+(g.estadoOutlook=='cerrado'?' (Outlook clásico está cerrado: los colores son los recordados).':g.estadoOutlook=='no'?' (no hay Outlook clásico en este equipo, así que sin etiquetas).':'.'),
    ninguna:'Sin calendario todavía: pega un enlace ICS o abre Outlook clásico.',error:'No se pudo leer el enlace: '+g.error}[g.fuente]||'';
  $('est').textContent=o+(g.n?' '+g.n+' eventos en los próximos días.':'');
}
$('pr').onclick=async()=>{$('res').textContent='Probando…';const r=await api.icsProbar($('u').value);$('res').textContent=r.ok?'✓ Funciona: '+r.n+' eventos en los próximos 120 días.':'✗ No funciona: '+r.error};
$('gu').onclick=async()=>{await api.icsGuardar($('u').value);$('res').textContent='Guardado (se comparte con tus otros equipos).';estado()};
estado();
</script>
:::END
:::BEGIN preload.js|text|e9ff3d792b5b5539ec557fd266382255942d70e0ad73e7fdc5b8becb8b24236b
const {contextBridge,ipcRenderer:r}=require('electron');
contextBridge.exposeInMainWorld('api',{
  get:id=>r.invoke('get',id),
  save:(id,html,alarms)=>r.send('save',id,html,alarms),
  color:(id,c)=>r.send('color',id,c),
  z:id=>r.invoke('z',id),
  glass:id=>r.invoke('glass',id),
  cols:(id,v)=>r.send('cols',id,v),
  add:()=>r.send('new'),
  del:id=>r.send('del',id),
  close:()=>r.send('close'),
  min:()=>r.send('min'),
  cal:id=>r.invoke('cal',id),
  agenda:()=>r.invoke('agenda'),
  refrescar:()=>r.invoke('refrescar'),
  estilo:()=>r.invoke('estilo'),
  setEstilo:(f,l)=>r.send('estilo',f,l),
  onEstilo:f=>r.on('estilo',(_,e)=>f(e)),
  icsGet:()=>r.invoke('ics:get'),
  icsProbar:u=>r.invoke('ics:probar',u),
  icsGuardar:u=>r.invoke('ics:guardar',u),
  hechoCal:(id,k,v)=>r.send('hechoCal',id,k,v),
  lanz:(a,id)=>r.send('lanz',a,id),
  onLanz:f=>r.on('lanz',(_,l)=>f(l)),
  onSet:f=>r.on('set',(_,n)=>f(n)),
  onAgenda:f=>r.on('agenda',(_,ev)=>f(ev)),
});
:::END
